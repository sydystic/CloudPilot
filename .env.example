# =====================================================================
# CloudPilot Environment Configuration
# Copy this file to .env and fill in your values.
# =====================================================================

# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------
# BROWSER-SAFE SECRETS (Safe to send to browser / public clients)
# ---------------------------------------------------------------------
# Your Supabase project URL (e.g. https://xyz.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Your Supabase anonymous public key (safe for browser frontend)
SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------
# SERVER-ONLY SECRETS (CRITICAL: NEVER EXPOSE TO FRONTEND OR BROWSER)
# ---------------------------------------------------------------------
# Supabase Service Role Key (full admin bypasses RLS - SERVER ONLY!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n Workflow Automation Service Configuration (SERVER ONLY!)
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_CONTAINER_NAME=n8n

# AES-256-GCM Credential Encryption Key (32-byte hex string / 64 hex chars)
# Generate a new key by running: npm run gen-key
ENCRYPTION_KEY=64_char_hex_key_generated_by_npm_run_gen_key

# Demo Mode Flag (set to true to test with mock data without n8n/Supabase)
DEMO_MODE=false
