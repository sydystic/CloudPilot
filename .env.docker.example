# =====================================================================
# CloudPilot Docker Environment Configuration Example (.env.docker.example)
# Copy or merge this file into your .env when running with Docker Compose.
# =====================================================================

# ---------------------------------------------------------------------
# DOCKER CONTAINER & PORT SETTINGS
# ---------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
TZ=Asia/Kolkata

# n8n Internal PostgreSQL Settings (Docker container: cloudpilot-n8n-db)
# IMPORTANT: This is n8n's internal database ONLY — NOT CloudPilot's application DB!
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_db_secret_password
POSTGRES_DB=n8n

# n8n Container Name for docker exec diagnostic commands
N8N_CONTAINER_NAME=n8n

# ---------------------------------------------------------------------
# CLOUDPILOT BACKEND CONFIGURATION
# ---------------------------------------------------------------------
PORT=4000
FRONTEND_URL=http://localhost:3000

# BROWSER-SAFE KEYS
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER-ONLY SECRETS (NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n API Connection URL
# - If CloudPilot runs directly on host (npm run start): N8N_URL=http://localhost:5678
# - If CloudPilot runs inside Docker (docker-compose.full.yml): N8N_URL=http://n8n:5678
N8N_URL=http://localhost:5678

# n8n API Key (Generated inside n8n UI -> Settings -> n8n API -> Create API Key)
N8N_API_KEY=your-n8n-api-key-here

# AES-256-GCM Credential Encryption Key (Generate via: npm run gen-key)
ENCRYPTION_KEY=a24b2bc0297c4298f4694a561629ea5cb0aa743fa0494911f05e79a1b59127cc

# Demo mode (set to false when connected to real n8n & Supabase)
DEMO_MODE=false
